    "@react-three/rapier": "^1.3.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.38.0",
    "postprocessing": "^6.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/eslint": "^9.6.1",
